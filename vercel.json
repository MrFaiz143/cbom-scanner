{
  "version": 2,
  "builds": [
    {
      "src": "web/app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["src/**", "web/templates/**", "web/static/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "web/app.py"
    }
  ],
  "env": {
    "PYTHONPATH": "src:web:."
  }
}