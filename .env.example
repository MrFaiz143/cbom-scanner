# ============================================================
# CBOM Scanner - Environment Variables
# ============================================================
# Is file ko copy karke `.env` banao:
#   cp .env.example .env
# Phir apni real values daalo.
# ============================================================

# Environment: development | production
CBOM_ENV=development

# ------------------------------------------------------------
# ADMIN CREDENTIALS (CHANGE THESE!)
# ------------------------------------------------------------
CBOM_ADMIN_USER=admin
CBOM_ADMIN_PASS=change-this-to-a-strong-password

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
CBOM_DB_PATH=./cbom_scanner.db

# ------------------------------------------------------------
# SESSION / SECURITY
# ------------------------------------------------------------
# Session validity in days
CBOM_SESSION_DAYS=7

# Cookie secure flag (true in production with HTTPS)
CBOM_COOKIE_SECURE=false

# Cookie SameSite: lax | strict | none
CBOM_COOKIE_SAMESITE=lax

# Minimum password length
CBOM_MIN_PASSWORD_LEN=8

# ------------------------------------------------------------
# SCANNING
# ------------------------------------------------------------
# Max hosts in multi-host scan
CBOM_MAX_MULTI_HOSTS=50

# Scan timeout (seconds)
CBOM_SCAN_TIMEOUT=10

# Port check timeout (seconds)
CBOM_PORT_TIMEOUT=3

# Concurrent workers
CBOM_MAX_WORKERS=50

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
CBOM_LOG_LEVEL=INFO

# ------------------------------------------------------------
# REPORTS
# ------------------------------------------------------------
CBOM_REPORTS_DIR=./reports